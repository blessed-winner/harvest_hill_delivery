# Environment Variables Example for Docker Deployment

# PostgreSQL
POSTGRES_DB=harvesthill
POSTGRES_USER=harvesthill
POSTGRES_PASSWORD=harvesthill_dev_password_change_me

# Backend Django
SECRET_KEY=django-insecure-docker-secret-key-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Next.js
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
